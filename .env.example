# Copy this file to `.env` and replace the EXAMPLE values before first run:
#   cp .env.example .env
#
# Never commit `.env` — it is gitignored.
#
# ═══════════════════════════════════════════════════════════════════════════
# SENSITIVE: set DB_USER and DB_PASSWORD yourself.
# The values below are EXAMPLES only and must not be used as-is in any
# shared or production environment.
# ═══════════════════════════════════════════════════════════════════════════

DB_NAME=reading_library
DB_USER=example_user
DB_PASSWORD=example_password

# Only needed when using docker-compose.external-db.yml (host/external Postgres):
# DB_HOST=host.docker.internal
# DB_PORT=5432

# Portable / SQLite (optional — used by scripts/run_portable.sh):
# DB_ENGINE=sqlite
# SQLITE_PATH=portable/data/reading_library.db
# UPLOADS_DIR=portable/uploads
# STATIC_DIR=frontend/dist
# APP_HOST=127.0.0.1
# APP_PORT=3050
