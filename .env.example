# Optional — defaults work for Docker Compose self-host.
# Copy to `.env` only if you want to override values:
#   cp .env.example .env
#
# Never commit `.env` — it is gitignored.

# APP_HOST=0.0.0.0
# APP_PORT=3050

# SQLite (Compose mounts ./data → /data):
# SQLITE_PATH=/data/reading_library.db
# UPLOADS_DIR=/data/uploads
# STATIC_DIR=frontend/dist

# Local portable run (scripts/run_portable.sh) uses portable/ by default:
# SQLITE_PATH=portable/data/reading_library.db
# UPLOADS_DIR=portable/uploads
# STATIC_DIR=frontend/dist
# APP_HOST=127.0.0.1
# APP_PORT=3050
